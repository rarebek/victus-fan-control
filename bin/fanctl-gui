        release_unit.get_style_context().add_class("muted")
        release_box.pack_start(release_unit, False, False, 0)

        save_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        automax_card.pack_start(save_box, False, False, 0)
        save_auto = Gtk.Button(label="Save Auto Max")
        save_auto.connect("clicked", lambda _b: self.save_rules())
        save_box.pack_end(save_auto, False, False, 0)

        self.capability_label = Gtk.Label(label="", xalign=0)
        self.capability_label.get_style_context().add_class("muted")
        self.capability_label.set_line_wrap(True)
        page.pack_start(self.capability_label, False, False, 0)

    def make_card(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.get_style_context().add_class("card")
        box.set_hexpand(True)
        return box

    def make_spin(self, value, minimum, maximum, step=1):
        spin = Gtk.SpinButton()
        spin.set_range(minimum, maximum)
        spin.set_increments(step, step * 5)
        spin.set_value(value)
        return spin

    def add_stat(self, grid, column, row, title):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        grid.attach(box, column, row, 1, 1)
        label = Gtk.Label(label=title, xalign=0)
        label.get_style_context().add_class("stat-label")
        box.pack_start(label, False, False, 0)
        value = Gtk.Label(label="n/a", xalign=0)
        value.get_style_context().add_class("stat-value")
        box.pack_start(value, False, False, 0)
        return value

    def add_threshold_row(self, grid, row, title, unit, on_value, on_min, on_max, off_value, off_min, off_max):
        label = Gtk.Label(label=title, xalign=0)
        grid.attach(label, 0, row, 1, 1)
        on_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        on_spin = self.make_spin(on_value, on_min, on_max)
        on_box.pack_start(on_spin, False, False, 0)
        on_unit = Gtk.Label(label=unit)
        on_unit.get_style_context().add_class("muted")
        on_box.pack_start(on_unit, False, False, 0)
        grid.attach(on_box, 1, row, 1, 1)
        off_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        off_spin = self.make_spin(off_value, off_min, off_max)
        off_box.pack_start(off_spin, False, False, 0)
        off_unit = Gtk.Label(label=unit)
        off_unit.get_style_context().add_class("muted")
        off_box.pack_start(off_unit, False, False, 0)
        grid.attach(off_box, 2, row, 1, 1)
        return on_spin, off_spin

    def start_custom_timer(self):
        minutes = int(self.custom_minutes_spin.get_value())
        self.run_action(["max", "--for", f"{minutes}m"], f"Max {minutes}m")

    def add_spin_row(self, grid, row, label, value, minimum, maximum, step=1):
        key = Gtk.Label(label=label, xalign=0)
        key.get_style_context().add_class("key")
        grid.attach(key, 0, row, 1, 1)
        spin = Gtk.SpinButton()
        spin.set_range(minimum, maximum)
        spin.set_increments(step, step * 5)
        spin.set_value(value)
        grid.attach(spin, 1, row, 1, 1)
        return spin

    def build_rules(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
