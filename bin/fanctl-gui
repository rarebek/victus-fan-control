def gtk_log_handler(domain, level, message, user_data):
    if "gtk_widget_get_scale_factor" in message:
        return
    GLib.log_default_handler(domain, level, message, user_data)


GLib.log_set_handler("Gtk", GLib.LogLevelFlags.LEVEL_CRITICAL, gtk_log_handler, None)


APP_ID = "victus-fan-control"
LEGACY_APP_ID = "hp-fan-control"
APP_NAME = "Victus Fan Control"
HWMON_ROOT = Path("/sys/class/hwmon")
STATE_ROOT = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
CONFIG_ROOT = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
STATE_DIR = Path(os.environ.get("FANCTL_STATE_DIR", str(STATE_ROOT / APP_ID)))
CONFIG_DIR = Path(os.environ.get("FANCTL_CONFIG_DIR", str(CONFIG_ROOT / APP_ID)))
CONFIG_FILE = CONFIG_DIR / "config.json"
LEGACY_CONFIG_FILE = CONFIG_ROOT / LEGACY_APP_ID / "config.json"
EVENT_LOG = STATE_DIR / "events.log"
AUTOSTART_FILE = Path.home() / ".config/autostart" / f"{APP_ID}.desktop"


def resolve_fanctl():
    override = os.environ.get("FANCTL")
    if override:
        return override

    sibling = Path(__file__).resolve().with_name("fanctl")
    if sibling.exists():
        return str(sibling)

    found = shutil.which("fanctl")
    return found or "fanctl"


def resolve_gui():
    current = Path(sys.argv[0])
    if current.is_absolute() or current.parent != Path("."):
        return str(current.resolve())

    found = shutil.which(current.name)
    return found or "fanctl-gui"


FANCTL = resolve_fanctl()
GUI_EXEC = resolve_gui()


DEFAULT_CONFIG = {
    "refresh_interval": 2,
    "notifications": True,
    "tray": True,
    "reset_on_start": False,
    "reset_on_exit": False,
    "autostart": False,
    "gpu_monitoring": True,
    "auto_boost_enabled": False,
    "cpu_on": 80,
    "cpu_off": 68,
    "gpu_on": 78,
    "gpu_off": 65,
    "gpu_util_on": 60,
    "gpu_util_off": 20,
    "activate_delay": 6,
    "deactivate_delay": 45,
    "high_cpu_warning": 92,
    "high_gpu_warning": 86,
    "better_auto_enabled": False,
    "better_auto_levels": [
        {"temp": 50, "percent": 35},
        {"temp": 62, "percent": 50},
        {"temp": 72, "percent": 70},
        {"temp": 82, "percent": 100},
    ],
}


def ensure_dirs():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)


def load_config():
    ensure_dirs()
    source = CONFIG_FILE
    if not source.exists() and LEGACY_CONFIG_FILE.exists():
        source = LEGACY_CONFIG_FILE

    if not source.exists():
        config = dict(DEFAULT_CONFIG)
        save_config(config)
        return config

    try:
        loaded = json.loads(source.read_text())
    except (OSError, json.JSONDecodeError):
        return dict(DEFAULT_CONFIG)

    config = dict(DEFAULT_CONFIG)
    config.update({k: v for k, v in loaded.items() if k in DEFAULT_CONFIG})
    return config


def save_config(config):
    ensure_dirs()
    CONFIG_FILE.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")


def read_text(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return None


def write_log(message):
    ensure_dirs()
    with EVENT_LOG.open("a") as handle:
        handle.write(f"{time.strftime('%F %T')} {message}\n")


def hwmon_by_name(name):
    for path in sorted(HWMON_ROOT.glob("hwmon*")):
        if read_text(path / "name") == name:
            return path
    return None


def hp_hwmon():
    return hwmon_by_name("hp")


def parse_int(value):
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return None


def milli_to_c(raw):
    value = parse_int(raw)
    if value is None:
        return None
    return value / 1000.0


def fan_mode():
    hwmon = hp_hwmon()
    if not hwmon:
        return {"raw": None, "label": "unavailable"}

    raw = read_text(hwmon / "pwm1_enable")
    label = {
        "0": "max",
        "1": "manual",
        "2": "auto",
    }.get(raw, f"unknown ({raw or 'n/a'})")
    return {"raw": raw, "label": label}


def runtime_dir():
    return Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))


def max_hold_pid():
    raw = read_text(runtime_dir() / "fanctl-max.pid")
    if not raw or not raw.isdigit():
        return None
    pid = int(raw)
    try:
        os.kill(pid, 0)
    except OSError:
        return None
    return pid


def max_hold_deadline():
    raw = read_text(runtime_dir() / "fanctl-max.deadline")
    if not raw or not raw.isdigit():
        return None
    return int(raw)


def fan_rpms():
    hwmon = hp_hwmon()
    result = {
        "fan1": None,
        "fan2": None,
        "fan1_target": None,
        "fan2_target": None,
        "fan1_max": None,
        "fan2_max": None,
    }
    if not hwmon:
        return result

    for idx in (1, 2):
        result[f"fan{idx}"] = parse_int(read_text(hwmon / f"fan{idx}_input"))
        result[f"fan{idx}_target"] = parse_int(read_text(hwmon / f"fan{idx}_target"))
        result[f"fan{idx}_max"] = parse_int(read_text(hwmon / f"fan{idx}_max"))
    return result


def capability_map():
    hwmon = hp_hwmon()
    caps = {
        "hp_hwmon": bool(hwmon),
        "fan_mode": False,
        "fan_rpm": False,
        "manual_targets": False,
        "manual_targets_writable": False,
        "fan_max": False,
        "keyboard_rgb": False,
        "singlezone_rgb": False,
        "fourzone_rgb": False,
    }
    if hwmon:
        caps["fan_mode"] = (hwmon / "pwm1_enable").exists()
        caps["fan_rpm"] = (hwmon / "fan1_input").exists() or (hwmon / "fan2_input").exists()
        caps["manual_targets"] = (hwmon / "fan1_target").exists() and (hwmon / "fan2_target").exists()
        caps["manual_targets_writable"] = os.access(hwmon / "fan1_target", os.W_OK) and os.access(hwmon / "fan2_target", os.W_OK)
        caps["fan_max"] = (hwmon / "fan1_max").exists() and (hwmon / "fan2_max").exists()

    single = Path("/sys/class/leds/hp::kbd_backlight")
    zones = Path("/sys/devices/platform/hp-wmi/rgb_zones")
    caps["singlezone_rgb"] = (single / "multi_intensity").exists() or (single / "brightness").exists()
    caps["fourzone_rgb"] = (zones / "zone00").exists()
    caps["keyboard_rgb"] = caps["singlezone_rgb"] or caps["fourzone_rgb"]
    return caps


def cpu_package_temp():
    coretemp = hwmon_by_name("coretemp")
    if not coretemp:
        return None

    fallback = None
    for temp_input in sorted(coretemp.glob("temp*_input")):
        label = read_text(str(temp_input).replace("_input", "_label"))
        value = milli_to_c(read_text(temp_input))
        if value is None:
            continue
        if label == "Package id 0":
            return value
        if fallback is None:
            fallback = value
    return fallback


def chassis_temp():
    acpi = hwmon_by_name("acpitz")
    if not acpi:
        return None
    return milli_to_c(read_text(acpi / "temp1_input"))


def nvme_temp():
    nvme = hwmon_by_name("nvme")
    if not nvme:
        return None
    return milli_to_c(read_text(nvme / "temp1_input"))


def nvidia_snapshot(enabled=True):
    empty = {
        "available": False,
        "name": "n/a",
        "driver": "n/a",
        "temp": None,
        "util": None,
        "mem_util": None,
        "power": None,
        "power_limit": None,
        "graphics_clock": None,
        "memory_clock": None,
        "pstate": "n/a",
        "fan_speed": "N/A",
    }
    if not enabled:
        return empty

    query = (
        "name,driver_version,temperature.gpu,utilization.gpu,"
        "utilization.memory,power.draw,power.limit,clocks.current.graphics,"
        "clocks.current.memory,pstate,fan.speed"
    )
    try:
        result = subprocess.run(
            [
                "nvidia-smi",
                f"--query-gpu={query}",
                "--format=csv,noheader,nounits",
            ],
            text=True,
            capture_output=True,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return empty

    if result.returncode != 0 or not result.stdout.strip():
        return empty

    values = [part.strip() for part in result.stdout.strip().splitlines()[0].split(",")]
    if len(values) < 11:
        return empty

    def number(index):
        raw = values[index]
        if raw in {"[N/A]", "N/A", ""}:
            return None
        try:
            return float(raw)
        except ValueError:
            return None

    power = number(5)
    power_limit = number(6)
    if power is not None and power > 250:
        power = None
    if power_limit is not None and power_limit > 250:
        power_limit = None

    return {
        "available": True,
        "name": values[0],
        "driver": values[1],
        "temp": number(2),
        "util": number(3),
        "mem_util": number(4),
        "power": power,
        "power_limit": power_limit,
        "graphics_clock": number(7),
        "memory_clock": number(8),
        "pstate": values[9],
        "fan_speed": values[10],
    }


def collect_snapshot(config):
    now = time.time()
    fans = fan_rpms()
    hold_pid = max_hold_pid()
    deadline = max_hold_deadline() if hold_pid else None
    remaining = None
    if deadline:
        remaining = max(0, int(deadline - now))

    return {
        "time": now,
        "mode": fan_mode(),
        "hold_pid": hold_pid,
        "hold_remaining": remaining,
        "fans": fans,
        "cpu_temp": cpu_package_temp(),
        "chassis_temp": chassis_temp(),
        "nvme_temp": nvme_temp(),
        "gpu": nvidia_snapshot(config.get("gpu_monitoring", True)),
        "caps": capability_map(),
    }


def fmt_temp(value):
    return "n/a" if value is None else f"{value:.1f} C"


def fmt_percent(value):
    return "n/a" if value is None else f"{value:.0f}%"


def fmt_watts(value):
    return "n/a" if value is None else f"{value:.1f} W"


def fmt_clock(value):
    return "n/a" if value is None else f"{value:.0f} MHz"


def fmt_rpm(value):
    return "n/a" if value is None else f"{value} RPM"


def fmt_duration(seconds):
    if seconds is None:
        return "n/a"
    seconds = max(0, int(seconds))
    minutes, sec = divmod(seconds, 60)
    hours, minutes = divmod(minutes, 60)
    if hours:
        return f"{hours}h {minutes}m"
    if minutes:
        return f"{minutes}m {sec:02d}s"
    return f"{sec}s"


def notify(title, body, config):
    if not config.get("notifications", True):
        return
    try:
        subprocess.Popen(["notify-send", title, body], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


class FanWindow(Gtk.Window):
    def __init__(self, minimized=False):
        super().__init__(title=APP_NAME)
        self.config = load_config()
        self.snapshot = None
        self.busy = False
        self.boost_active = False
        self.hot_seconds = 0
        self.cool_seconds = 0
        self.last_hold_pid = None
        self.warned_cpu_hot = False
        self.warned_gpu_hot = False
        self.tray = None
        self.start_minimized = minimized

        self.set_default_size(920, 680)
        self.set_border_width(12)
        self.connect("destroy", self.on_destroy)

        self.install_css()
        self.build_ui()

        if self.config.get("reset_on_start", False):
            self.run_action(["auto"], "Auto on launch")

        self.refresh()
        GLib.timeout_add_seconds(int(self.config["refresh_interval"]), self.refresh)
    def install_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(
            b"""
            .title { font-size: 18px; font-weight: 700; }
            .section { font-weight: 700; font-size: 13px; }
            .muted { opacity: 0.62; font-size: 12px; }
            .key { opacity: 0.78; }
            .stat-label {
              font-size: 10px;
              font-weight: 600;
              opacity: 0.6;
            }
            .stat-value {
              font-size: 15px;
              font-weight: 600;
            }
            .card {
              background-color: alpha(@theme_fg_color, 0.05);
              border: 1px solid alpha(@theme_fg_color, 0.12);
              border-radius: 8px;
              padding: 10px 12px;
            }
            .control-card {
              background-color: alpha(@theme_fg_color, 0.07);
              border: 1px solid alpha(@theme_fg_color, 0.14);
              border-radius: 8px;
              padding: 12px 14px;
            }
            button.suggested-action,
            button.destructive-action {
              padding-left: 16px;
              padding-right: 16px;
              font-weight: 600;
            }
            """
        )
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def build_ui(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(root)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        root.pack_start(header, False, False, 0)

        title = Gtk.Label(label=APP_NAME, xalign=0)
        title.get_style_context().add_class("title")
        header.pack_start(title, True, True, 0)

        self.spinner = Gtk.Spinner()
        header.pack_start(self.spinner, False, False, 0)

        self.last_action = Gtk.Label(label="", xalign=1)
        header.pack_start(self.last_action, False, False, 0)

        self.notebook = Gtk.Notebook()
        root.pack_start(self.notebook, True, True, 0)

        self.build_dashboard()
        self.build_rules()
        self.build_advanced()
        self.build_logs()

    def build_dashboard(self):
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        page.set_border_width(8)
        scroll.add(page)
        self.notebook.append_page(scroll, Gtk.Label(label="Dashboard"))

        self.labels = {}

        controls_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        controls_card.get_style_context().add_class("control-card")
        page.pack_start(controls_card, False, False, 0)

        controls_title = Gtk.Label(label="Fan control", xalign=0)
        controls_title.get_style_context().add_class("section")
        controls_card.pack_start(controls_title, False, False, 0)

        primary_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        controls_card.pack_start(primary_row, False, False, 0)

        self.auto_button = Gtk.Button(label="Auto")
        self.auto_button.get_style_context().add_class("suggested-action")
        self.auto_button.connect("clicked", lambda _b: self.run_action(["auto"], "Auto"))
        primary_row.pack_start(self.auto_button, False, False, 0)

        self.max_button = Gtk.Button(label="Max")
        self.max_button.get_style_context().add_class("destructive-action")
        self.max_button.connect("clicked", lambda _b: self.run_action(["max"], "Max"))
        primary_row.pack_start(self.max_button, False, False, 0)

        primary_row.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 6)

        hold_label = Gtk.Label(label="Hold Max for", xalign=0)
        hold_label.get_style_context().add_class("muted")
        primary_row.pack_start(hold_label, False, False, 0)

        timed_group = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        timed_group.get_style_context().add_class("linked")
        primary_row.pack_start(timed_group, False, False, 0)
        for label_text, duration in (("5m", "5m"), ("15m", "15m"), ("30m", "30m"), ("1h", "1h")):
            button = Gtk.Button(label=label_text)
            button.connect("clicked", lambda _b, d=duration: self.run_action(["max", "--for", d], f"Max {d}"))
            timed_group.pack_start(button, True, True, 0)

        primary_row.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 6)

        custom_label = Gtk.Label(label="Custom", xalign=0)
        custom_label.get_style_context().add_class("muted")
