        )
        self.rule_spins["high_gpu_warning"] = self.add_spin_row(
            warning_grid, 1, "GPU Warning", self.config["high_gpu_warning"], 50, 105
        )

        checks = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        page.pack_start(checks, False, False, 0)

        self.notify_check = Gtk.CheckButton(label="Notifications")
        self.notify_check.set_active(bool(self.config["notifications"]))
        checks.pack_start(self.notify_check, False, False, 0)

        self.gpu_monitor_check = Gtk.CheckButton(label="GPU Monitoring")
        self.gpu_monitor_check.set_active(bool(self.config["gpu_monitoring"]))
        checks.pack_start(self.gpu_monitor_check, False, False, 0)

        self.reset_start_check = Gtk.CheckButton(label="Auto on App Start")
        self.reset_start_check.set_active(bool(self.config["reset_on_start"]))
        checks.pack_start(self.reset_start_check, False, False, 0)

        self.reset_exit_check = Gtk.CheckButton(label="Auto on App Exit")
        self.reset_exit_check.set_active(bool(self.config["reset_on_exit"]))
        checks.pack_start(self.reset_exit_check, False, False, 0)

        self.autostart_check = Gtk.CheckButton(label="Start in Tray on Login")
        self.autostart_check.set_active(bool(self.config["autostart"]))
        checks.pack_start(self.autostart_check, False, False, 0)

        save = Gtk.Button(label="Save Rules")
        save.connect("clicked", lambda _button: self.save_rules())
        page.pack_start(save, False, False, 0)

    def build_advanced(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        page.set_border_width(8)
        self.notebook.append_page(page, Gtk.Label(label="Advanced"))

        manual_frame = Gtk.Frame(label="Manual RPM")
        page.pack_start(manual_frame, False, False, 0)
        manual_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        manual_box.set_border_width(10)
        manual_frame.add(manual_box)

        manual_grid = Gtk.Grid(column_spacing=16, row_spacing=8)
        manual_box.pack_start(manual_grid, False, False, 0)
        self.fan1_spin = self.add_spin_row(manual_grid, 0, "Fan 1 RPM", 3000, 0, 7000, 100)
        self.fan2_spin = self.add_spin_row(manual_grid, 1, "Fan 2 RPM", 3000, 0, 7000, 100)
        self.manual_apply = Gtk.Button(label="Apply Manual RPM")
        self.manual_apply.connect("clicked", lambda _button: self.apply_manual())
        manual_box.pack_start(self.manual_apply, False, False, 0)
        self.manual_note = Gtk.Label(label="", xalign=0)
        manual_box.pack_start(self.manual_note, False, False, 0)

        curve_frame = Gtk.Frame(label="Better Auto Curve")
        page.pack_start(curve_frame, False, False, 0)
        curve_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        curve_box.set_border_width(10)
        curve_frame.add(curve_box)
        self.better_auto_check = Gtk.CheckButton(label="Better Auto")
        self.better_auto_check.set_active(bool(self.config["better_auto_enabled"]))
        curve_box.pack_start(self.better_auto_check, False, False, 0)

        self.curve_grid = Gtk.Grid(column_spacing=14, row_spacing=6)
        curve_box.pack_start(self.curve_grid, False, False, 0)
        self.curve_spins = []
        for idx, level in enumerate(self.config["better_auto_levels"]):
            temp_spin = self.add_spin_row(self.curve_grid, idx, f"Level {idx + 1} Temp", level["temp"], 35, 100)
            pct_spin = Gtk.SpinButton()
            pct_spin.set_range(20, 100)
            pct_spin.set_increments(5, 10)
            pct_spin.set_value(level["percent"])
            self.curve_grid.attach(pct_spin, 2, idx, 1, 1)
            pct_label = Gtk.Label(label="%", xalign=0)
            self.curve_grid.attach(pct_label, 3, idx, 1, 1)
            self.curve_spins.append((temp_spin, pct_spin))

        curve_save = Gtk.Button(label="Save Curve")
        curve_save.connect("clicked", lambda _button: self.save_rules())
        curve_box.pack_start(curve_save, False, False, 0)

        rgb_frame = Gtk.Frame(label="Keyboard RGB")
        page.pack_start(rgb_frame, False, False, 0)
        rgb_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        rgb_box.set_border_width(10)
        rgb_frame.add(rgb_box)
        self.color_button = Gtk.ColorButton()
        self.color_button.connect("color-set", self.apply_rgb_color)
        rgb_box.pack_start(self.color_button, False, False, 0)
        self.brightness = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 255, 1)
        self.brightness.set_value(128)
        self.brightness.connect("value-changed", self.apply_rgb_brightness)
        rgb_box.pack_start(self.brightness, True, True, 0)
        self.rgb_note = Gtk.Label(label="", xalign=0)
        page.pack_start(self.rgb_note, False, False, 0)

    def build_logs(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        page.set_border_width(8)
        self.notebook.append_page(page, Gtk.Label(label="Log"))

        scroll = Gtk.ScrolledWindow()
        page.pack_start(scroll, True, True, 0)
        self.log_view = Gtk.TextView()
        self.log_view.set_editable(False)
        self.log_view.set_monospace(True)
        scroll.add(self.log_view)

        clear = Gtk.Button(label="Clear Log")
        clear.connect("clicked", lambda _button: self.clear_log())
        page.pack_start(clear, False, False, 0)
        self.load_log()

    def setup_tray(self):
        if not self.config.get("tray", True):
            return
        try:
            self.tray = Gtk.StatusIcon.new_from_icon_name("preferences-system-power-management")
            self.tray.set_title(APP_NAME)
            self.tray.set_visible(True)
            self.tray.connect("activate", lambda _icon: self.present_window())
            self.tray.connect("popup-menu", self.show_tray_menu)
        except Exception:
            self.tray = None

    def show_tray_menu(self, _icon, button, activate_time):
        menu = Gtk.Menu()
        items = [
            ("Open", lambda *_: self.present_window()),
            ("Max", lambda *_: self.run_action(["max"], "Max")),
            ("Max 15 min", lambda *_: self.run_action(["max", "--for", "15m"], "Max 15m")),
            ("Auto", lambda *_: self.run_action(["auto"], "Auto")),
            ("Quit", lambda *_: self.destroy()),
        ]
        for label, callback in items:
            item = Gtk.MenuItem(label=label)
            item.connect("activate", callback)
            menu.append(item)
        menu.show_all()
        menu.popup(None, None, None, None, button, activate_time)

    def present_window(self):
        self.show_all()
        self.present()

    def set_busy(self, busy, text=""):
        self.busy = busy
        self.auto_button.set_sensitive(not busy)
        self.max_button.set_sensitive(not busy)
        self.manual_apply.set_sensitive(not busy and self.manual_apply.get_sensitive())
        self.last_action.set_text(text)
        if busy:
            self.spinner.start()
        else:
            self.spinner.stop()

    def refresh(self):
        self.snapshot = collect_snapshot(self.config)
        snap = self.snapshot
        fans = snap["fans"]
        gpu = snap["gpu"]

        self.labels["mode"].set_text(snap["mode"]["label"].upper())

        if snap["hold_pid"]:
            self.labels["hold"].set_text(f"running (pid {snap['hold_pid']})")
        else:
            self.labels["hold"].set_text("stopped")

        if snap["hold_pid"] and snap["hold_remaining"] is not None:
            self.labels["timer"].set_text(fmt_duration(snap["hold_remaining"]))
        else:
            self.labels["timer"].set_text("—")

        self.labels["fan1"].set_text(fmt_rpm(fans["fan1"]))
        self.labels["fan2"].set_text(fmt_rpm(fans["fan2"]))
        self.labels["cpu"].set_text(fmt_temp(snap["cpu_temp"]))
        self.labels["gpu_temp"].set_text(fmt_temp(gpu["temp"]))

        self.labels["chassis"].set_text(fmt_temp(snap["chassis_temp"]))
        self.labels["nvme"].set_text(fmt_temp(snap["nvme_temp"]))
        self.labels["gpu_util"].set_text(fmt_percent(gpu["util"]))
        self.labels["gpu_power"].set_text(fmt_watts(gpu["power"]))
        self.labels["gpu_clocks"].set_text(f"{fmt_clock(gpu['graphics_clock'])} / {fmt_clock(gpu['memory_clock'])}")
        self.labels["gpu_state"].set_text(gpu["pstate"] if gpu["available"] else "n/a")

        if gpu["available"]:
            short_name = gpu["name"].replace("NVIDIA ", "").replace(" Laptop GPU", "")
            self.labels["gpu_name"].set_text(short_name)
        elif not self.config.get("gpu_monitoring", True):
            self.labels["gpu_name"].set_text("monitoring off")
        else:
            self.labels["gpu_name"].set_text("n/a")

        self.update_capability_ui(snap["caps"], fans)
        self.evaluate_rules(snap)
        self.check_hold_transition(snap)
        self.update_tray(snap)
        return True

    def update_capability_ui(self, caps, fans):
        bits = []
        bits.append("manual RPM available" if caps["manual_targets"] else "manual RPM unavailable")
        bits.append("keyboard RGB available" if caps["keyboard_rgb"] else "keyboard RGB unavailable")
        bits.append("GPU stats available" if self.snapshot["gpu"]["available"] else "GPU stats unavailable")
        self.capability_label.set_text("   ·   ".join(bits))

        manual_ok = caps["manual_targets"]
        self.manual_apply.set_sensitive(manual_ok and not self.busy)
        self.better_auto_check.set_sensitive(manual_ok and caps["manual_targets_writable"])
        self.manual_note.set_text(
            "Patched hp-wmi fan target files detected." if manual_ok else "Manual RPM needs patched hp-wmi fan target files."
        )

        for idx in (1, 2):
            max_rpm = fans.get(f"fan{idx}_max") or 7000
            spin = self.fan1_spin if idx == 1 else self.fan2_spin
            spin.set_range(0, max_rpm)

        rgb_ok = caps["keyboard_rgb"]
        self.color_button.set_sensitive(rgb_ok)
        self.brightness.set_sensitive(rgb_ok)
        self.rgb_note.set_text("Keyboard lighting interface detected." if rgb_ok else "Keyboard lighting interface not detected.")

    def check_hold_transition(self, snap):
        pid = snap["hold_pid"]
        if self.last_hold_pid and not pid and snap["mode"]["raw"] == "2":
            self.log("Max hold ended; fan mode is auto")
            notify(APP_NAME, "Max hold ended; fan mode is auto", self.config)
        self.last_hold_pid = pid

    def evaluate_rules(self, snap):
        self.warn_if_hot(snap)
        if self.config.get("better_auto_enabled") and snap["caps"]["manual_targets_writable"]:
            self.evaluate_better_auto(snap)
        if not self.config.get("auto_boost_enabled", False):
            self.hot_seconds = 0
            self.cool_seconds = 0
            return

        interval = int(self.config["refresh_interval"])
        gpu = snap["gpu"]
        hot_reasons = []
        if snap["cpu_temp"] is not None and snap["cpu_temp"] >= self.config["cpu_on"]:
            hot_reasons.append(f"CPU {snap['cpu_temp']:.0f} C")
        if gpu["temp"] is not None and gpu["temp"] >= self.config["gpu_on"]:
            hot_reasons.append(f"GPU {gpu['temp']:.0f} C")
        if gpu["util"] is not None and gpu["util"] >= self.config["gpu_util_on"]:
            hot_reasons.append(f"GPU {gpu['util']:.0f}%")

        cool = True
        if snap["cpu_temp"] is not None and snap["cpu_temp"] > self.config["cpu_off"]:
            cool = False
        if gpu["temp"] is not None and gpu["temp"] > self.config["gpu_off"]:
            cool = False
        if gpu["util"] is not None and gpu["util"] > self.config["gpu_util_off"]:
            cool = False

        if hot_reasons:
            self.hot_seconds += interval
            self.cool_seconds = 0
        elif cool:
            self.cool_seconds += interval
            self.hot_seconds = 0
        else:
            self.hot_seconds = 0
            self.cool_seconds = 0

        if not self.boost_active and self.hot_seconds >= self.config["activate_delay"]:
            if self.busy:
                return
            reason = ", ".join(hot_reasons) or "threshold"
            self.boost_active = True
            self.log(f"Auto Boost started: {reason}")
            notify(APP_NAME, f"Auto Boost started: {reason}", self.config)
            self.run_action(["max"], "Auto Boost")
        elif self.boost_active and self.cool_seconds >= self.config["deactivate_delay"]:
            if self.busy:
                return
            self.boost_active = False
            self.log("Auto Boost cooled down; returning to auto")
            notify(APP_NAME, "Auto Boost cooled down; returning to auto", self.config)
            self.run_action(["auto"], "Auto Boost Auto")

    def warn_if_hot(self, snap):
        cpu = snap["cpu_temp"]
        gpu = snap["gpu"]["temp"]
        if cpu is not None and cpu >= self.config["high_cpu_warning"] and not self.warned_cpu_hot:
            self.warned_cpu_hot = True
            self.log(f"High CPU temperature: {cpu:.0f} C")
            notify(APP_NAME, f"High CPU temperature: {cpu:.0f} C", self.config)
        elif cpu is not None and cpu < self.config["high_cpu_warning"] - 8:
            self.warned_cpu_hot = False

        if gpu is not None and gpu >= self.config["high_gpu_warning"] and not self.warned_gpu_hot:
            self.warned_gpu_hot = True
            self.log(f"High GPU temperature: {gpu:.0f} C")
            notify(APP_NAME, f"High GPU temperature: {gpu:.0f} C", self.config)
        elif gpu is not None and gpu < self.config["high_gpu_warning"] - 8:
            self.warned_gpu_hot = False

    def evaluate_better_auto(self, snap):
        hottest = max(v for v in [snap["cpu_temp"], snap["gpu"]["temp"]] if v is not None) if (snap["cpu_temp"] is not None or snap["gpu"]["temp"] is not None) else None
        if hottest is None:
            return
        fans = snap["fans"]
        max1 = fans["fan1_max"] or 6000
        max2 = fans["fan2_max"] or 6000
        percent = 0
        for level in sorted(self.config["better_auto_levels"], key=lambda item: item["temp"]):
            if hottest >= level["temp"]:
                percent = level["percent"]
        if percent <= 0:
            return
        rpm1 = int(max1 * percent / 100)
        rpm2 = int(max2 * percent / 100)
        now = time.time()
        if getattr(self, "last_better_auto_apply", 0) + 30 > now:
            return
        if self.busy:
            return
        self.last_better_auto_apply = now
        self.run_action(["manual", str(rpm1), str(rpm2)], "Better Auto")

    def update_tray(self, snap):
        if not self.tray:
            return
        gpu_temp = fmt_temp(snap["gpu"]["temp"])
        text = f"{snap['mode']['label']} | CPU {fmt_temp(snap['cpu_temp'])} | GPU {gpu_temp}"
        self.tray.set_tooltip_text(text)

    def save_rules(self):
        self.config["auto_boost_enabled"] = self.auto_boost_check.get_active()
        self.config["notifications"] = self.notify_check.get_active()
        self.config["gpu_monitoring"] = self.gpu_monitor_check.get_active()
        self.config["reset_on_start"] = self.reset_start_check.get_active()
        self.config["reset_on_exit"] = self.reset_exit_check.get_active()
        self.config["autostart"] = self.autostart_check.get_active()
        self.config["better_auto_enabled"] = self.better_auto_check.get_active()

        for key, spin in self.rule_spins.items():
            self.config[key] = int(spin.get_value())

        levels = []
        for temp_spin, pct_spin in self.curve_spins:
            levels.append({"temp": int(temp_spin.get_value()), "percent": int(pct_spin.get_value())})
        self.config["better_auto_levels"] = levels

        save_config(self.config)
        self.sync_autostart()
        self.log("Saved configuration")

    def sync_autostart(self):
        AUTOSTART_FILE.parent.mkdir(parents=True, exist_ok=True)
        if self.config["autostart"]:
            AUTOSTART_FILE.write_text(
                "[Desktop Entry]\n"
                "Type=Application\n"
                f"Name={APP_NAME}\n"
                f"Exec={GUI_EXEC} --minimized\n"
                "Terminal=false\n"
                "X-GNOME-Autostart-enabled=true\n"
            )
        else:
            try:
                AUTOSTART_FILE.unlink()
            except FileNotFoundError:
                pass

    def apply_manual(self):
        fan1 = int(self.fan1_spin.get_value())
        fan2 = int(self.fan2_spin.get_value())
        self.run_action(["manual", str(fan1), str(fan2)], "Manual RPM")

    def apply_rgb_color(self, button):
        rgba = button.get_rgba()
        r, g, b = int(rgba.red * 255), int(rgba.green * 255), int(rgba.blue * 255)
        single = Path("/sys/class/leds/hp::kbd_backlight/multi_intensity")
        zones = Path("/sys/devices/platform/hp-wmi/rgb_zones")
        if single.exists():
            self.write_privileged(single, f"{r} {g} {b}\n")
        elif (zones / "zone00").exists():
            value = f"{r:02X}{g:02X}{b:02X}\n"
            for zone in sorted(zones.glob("zone0*")):
                self.write_privileged(zone, value)

    def apply_rgb_brightness(self, scale):
        path = Path("/sys/class/leds/hp::kbd_backlight/brightness")
        if path.exists():
            self.write_privileged(path, f"{int(scale.get_value())}\n")

    def write_privileged(self, path, value):
        path = Path(path)
        if os.access(path, os.W_OK):
            try:
                path.write_text(value)
                return
            except OSError as exc:
                self.log(f"Write failed: {exc}")
                return
        def write_with_pkexec():
            subprocess.run(
                ["pkexec", "/usr/bin/tee", str(path)],
                input=value,
                text=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )

        threading.Thread(target=write_with_pkexec, daemon=True).start()

    def run_action(self, args, label):
        self.set_busy(True, label)
        threading.Thread(target=self._run_action, args=(args, label), daemon=True).start()

    def _run_action(self, args, label):
        try:
            result = subprocess.run([FANCTL] + args, text=True, capture_output=True, timeout=90, check=False)
            GLib.idle_add(self.finish_action, args, label, result.returncode, result.stderr)
        except (OSError, subprocess.TimeoutExpired) as exc:
            GLib.idle_add(self.finish_action, args, label, 1, str(exc))

    def finish_action(self, args, label, returncode, stderr):
        self.set_busy(False)
        self.refresh()
        if returncode == 0:
            self.log(f"{label}: ok")
            if args and args[0] == "auto":
                self.boost_active = False
            return False

        message = stderr.strip() or f"{label} failed"
        self.log(f"{label}: {message}")
        notify(APP_NAME, message, self.config)
        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE,
            text="Fan command failed",
        )
        dialog.format_secondary_text(message)
        dialog.run()
        dialog.destroy()
        return False

    def log(self, message):
        write_log(message)
        self.load_log()

    def load_log(self):
        buffer = self.log_view.get_buffer()
        try:
            lines = EVENT_LOG.read_text().splitlines()[-300:]
        except OSError:
            lines = []
        buffer.set_text("\n".join(lines))

    def clear_log(self):
        ensure_dirs()
        EVENT_LOG.write_text("")
        self.load_log()

    def on_destroy(self, _window):
        if self.config.get("reset_on_exit", False):
            subprocess.Popen([FANCTL, "auto"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        Gtk.main_quit()


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    minimized = "--minimized" in sys.argv
    if "--self-test" in sys.argv:
        settings = Gtk.Settings.get_default()
        if settings:
            settings.set_property("gtk-application-prefer-dark-theme", True)
        win = FanWindow(minimized=False)
        win.show_all()
        labels = []
        for i in range(win.notebook.get_n_pages()):
            tab = win.notebook.get_tab_label(win.notebook.get_nth_page(i))
            labels.append(tab.get_text())
        print("tabs=" + ",".join(labels))
        print("mode=" + win.labels["mode"].get_text())
        print("fan1=" + win.labels["fan1"].get_text())
        print("gpu=" + win.labels["gpu_temp"].get_text())
        print("dark_preferred=true")
        win.hide()
        return

    win = FanWindow(minimized=minimized)
    win.show_all()
    win.setup_tray()
    if minimized and win.tray:
        win.hide()
    Gtk.main()


if __name__ == "__main__":
    main()
