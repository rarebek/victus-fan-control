        primary_row.pack_start(self.custom_minutes_spin, False, False, 0)

        custom_unit = Gtk.Label(label="min")
        custom_unit.get_style_context().add_class("muted")
        primary_row.pack_start(custom_unit, False, False, 0)

        custom_button = Gtk.Button(label="Start")
        custom_button.connect("clicked", lambda _b: self.start_custom_timer())
        primary_row.pack_start(custom_button, False, False, 0)

        status_grid = Gtk.Grid(column_spacing=24, row_spacing=0, column_homogeneous=True)
        controls_card.pack_start(status_grid, False, False, 0)
        self.labels["mode"] = self.add_stat(status_grid, 0, 0, "Mode")
        self.labels["hold"] = self.add_stat(status_grid, 1, 0, "Max hold")
        self.labels["timer"] = self.add_stat(status_grid, 2, 0, "Timer")

        stats_card = self.make_card()
        page.pack_start(stats_card, False, False, 0)
        stats_grid = Gtk.Grid(column_spacing=24, row_spacing=8, column_homogeneous=True)
        stats_card.pack_start(stats_grid, False, False, 0)
        self.labels["fan1"] = self.add_stat(stats_grid, 0, 0, "Fan 1")
        self.labels["fan2"] = self.add_stat(stats_grid, 1, 0, "Fan 2")
        self.labels["cpu"] = self.add_stat(stats_grid, 2, 0, "CPU")
        self.labels["gpu_temp"] = self.add_stat(stats_grid, 3, 0, "GPU")
