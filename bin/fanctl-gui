        warning_card.pack_start(warning_title, False, False, 0)
        warning_grid = Gtk.Grid(column_spacing=16, row_spacing=8)
        warning_card.pack_start(warning_grid, False, False, 0)
        self.rule_spins["high_cpu_warning"] = self.add_spin_row(
