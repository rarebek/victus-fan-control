        release_box.pack_start(release_lbl, False, False, 0)
        self.rule_spins["deactivate_delay"] = self.make_spin(self.config["deactivate_delay"], 0, 300)
        release_box.pack_start(self.rule_spins["deactivate_delay"], False, False, 0)
